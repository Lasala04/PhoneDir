RewriteEngine On

# Forward the Authorization header so $_SERVER['HTTP_AUTHORIZATION'] is populated.
# Freehostia runs PHP as CGI/FastCGI, which drops this header unless we pass it
# through explicitly. Without this, every request returns 401.
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# NOTE: HTTPS is intentionally NOT forced. This Freehostia free plan has no SSL
# (port 443 is closed), so the API is served over plain HTTP. Do not add an
# HTTP->HTTPS redirect here or every request will bounce to a dead port.

# Block direct browser access to sensitive files.
<FilesMatch "^(connection|auth)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Disable directory listing.
Options -Indexes
